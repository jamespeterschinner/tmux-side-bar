#!/bin/zsh
set -ex

width=30

# Log location (override with TMUX_SIDE_BAR_LOG). Ensure the dir exists and
# never let a logging failure abort the script (set -e is on).
LOG_FILE="${TMUX_SIDE_BAR_LOG:-$HOME/.tmux/hook.log}"
mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
log() { echo "$*" >> "$LOG_FILE" 2>/dev/null || true; }

pane_exists() {
  tmux list-panes -F '#{pane_id}' | awk -v id="$1" '$1==id { found=1 } END { exit !found }'
}

pane_to_left() {
  tmux list-panes -F "#{pane_id} #{pane_left} #{pane_right}" |
  awk -v cur_left="$(tmux display-message -p "#{pane_left}")" \
      'cur_left==($3+2) { print $1 ; exit}'
}

shared_lhs_panes() {
  tmux list-panes -F "#{pane_id} #{pane_left} #{pane_right}" |
  awk -v cur_left="$(tmux display-message -p "#{pane_left}")" \
      -v cur_id="$(tmux display-message -p "#{pane_id}")" \
      'cur_id!=$1 && cur_left==$2 { print $1 }'
}

# Read the absolute path of the file currently open in a helix pane.
# Sends a :sh command into helix that resolves %{buffer_name} (shell-escaped
# by helix >= 25.01) to an absolute path, writes it to a temp file, then
# signals a tmux channel. We block on that channel instead of polling, so no
# sleep/poll loop is needed. Returns "" for non-helix panes or scratch buffers.
helix_open_file() {
  local pane="$1"
  local cmd
  cmd="$(tmux display-message -p -t "$pane" '#{pane_current_command}')"
  case "$cmd" in
    hx|helix) ;;
    *) return 0 ;;
  esac

  local tmpfile chan
  tmpfile="$(mktemp "${TMPDIR:-/tmp}/tmux-side-bar.XXXXXX")"
  chan="tmux-side-bar-$$"

  # Escape to normal mode first (mirrors helix-opener), then run the shell
  # command inside helix. realpath runs in helix's working dir; the trailing
  # `tmux wait-for -S` fires even when realpath fails (scratch buffer), so the
  # waiter below never hangs as long as helix executes the command line.
  tmux send-keys -t "$pane" Escape
  tmux send-keys -t "$pane" -l -- ":sh realpath -- %{buffer_name} > $tmpfile 2>/dev/null; tmux wait-for -S $chan"
  tmux send-keys -t "$pane" Enter

  # Block until helix signals the channel (no external sleep/poll needed).
  tmux wait-for "$chan"

  # $(<file) is a zsh builtin read (no external `cat`/`head`).
  local path="$(<"$tmpfile")"
  rm -f "$tmpfile" 2>/dev/null || true
  printf '%s' "${path%%$'\n'*}"
}

IFS=, read viewer_pane parent_pane pane_left pane_right pane_top pane_bottom window_height window_width <<< \
  "$(tmux display-message -p "#{@viewer_pane},#{@parent_pane},#{pane_left},#{pane_right},#{pane_top},#{pane_bottom},#{window_height},#{window_width}")"

if [[ -n "$viewer_pane" ]] && pane_exists "$viewer_pane"; then
  log "parent_pane: '$parent_pane'"
  tmux kill-pane -t "$viewer_pane"
  tmux set-option -p -t "$parent_pane" -u @viewer_pane

  if (( pane_right == window_width - 1 )); then
    log "moving right pane: '$parent_pane'"
    tmux resize-pane -t "$parent_pane" -L $((width + 1))
  elif (( pane_left == 0 )); then
    echo 'doing nothing'
    :
  else
    left_pane=$(pane_to_left)
    shared_lhs_panes=$(shared_lhs_panes)
    if [[ -n $left_pane && -z $shared_lhs_panes ]]; then
      log "moving left pane: '$left_pane'"
      tmux resize-pane -t "$left_pane" -L $((width + 1))
    fi
  fi

else

  IFS=, read parent_pane pane_left pane_top pane_bottom window_height <<< \
    "$(tmux display-message -p "#{pane_id},#{pane_left},#{pane_top},#{pane_bottom},#{window_height}")"

  TOGGLE_PATH="$(realpath "$(command -v -- "$0")")"

  initial_file="$(helix_open_file "$parent_pane")"

  bt_env=()
  [[ -n "$initial_file" ]] && bt_env=(-e "BT_INITIAL_PATH=$initial_file")

  new_pane="$(
    tmux split-window -h -b -P -F '#{pane_id}' -l "$width" \
      -c '#{pane_current_path}' \
      -e "PARENT_PANE=$parent_pane" \
      -e "EDITOR=$EDITOR" \
      -e "ON_EXIT=$TOGGLE_PATH" \
      "${bt_env[@]}" \
      ${FILE_TREE_VIEWER:=bt}
  )"
  tmux set-option -p -t "$parent_pane" @viewer_pane "$new_pane"
  tmux set-option -p -t "$parent_pane" @parent_pane "$parent_pane"

  tmux set-option -p -t "$new_pane" @viewer_pane "$new_pane"
  tmux set-option -p -t "$new_pane" @parent_pane "$parent_pane"
  tmux set-option -p -t "$new_pane" @dependant_pane "$parent_pane"
fi

